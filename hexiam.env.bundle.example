# HexIAM bundle env for docker-compose.with-hexiam.yaml
# Copy this to .hexiam/hexalgon-iam-system/.env.bundle and replace placeholders.

DATABASE_USER=hexiam
DATABASE_PASSWORD=change-me
DATABASE_NAME=hexiam
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_DB=hexiam
DATABASE_URL=postgresql://hexiam:change-me@hexiam-postgres:5432/hexiam

REDIS_HOST=hexiam-redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me
ALGORITHM=HS256
ENCRYPT_KEY=change-me-32-byte-secret
APP_NAME=HexIAM
APP_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://hexiam:8000

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=
MAIL_SERVER=
MAIL_SSL_TLS=0
MAIL_STARTTLS=1
